# Configuración Eficiente de Servidor y Cabeceras Open Graph para WhatsApp

# HTML y Páginas Principales
/*
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/*.css
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

# Recursos Multimedia e Imágenes de Vista Previa (Permite Crawling en WhatsApp y Redes Sociales)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
